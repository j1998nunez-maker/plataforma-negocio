# Copia este archivo a ".env" (sin ".example") y pon tus valores reales.
# El archivo ".env" NUNCA se sube a git (ya está en .gitignore) porque
# contiene contraseñas.

# Datos de conexión a tu PostgreSQL local.
# Si usas el docker-compose.yml incluido en este proyecto, el puerto es 5433
# (se eligió ese puerto porque en desarrollo detectamos un PostgreSQL nativo
# ya instalado usando el 5432 — si tu caso es distinto, usa 5432).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=plataforma_negocio
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave

# Clave secreta para firmar los tokens JWT (invéntate una larga y random).
# Puedes generar una con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia_esta_clave_por_una_generada_con_secrets
JWT_ALGORITHM=HS256
JWT_EXPIRACION_MINUTOS=480
