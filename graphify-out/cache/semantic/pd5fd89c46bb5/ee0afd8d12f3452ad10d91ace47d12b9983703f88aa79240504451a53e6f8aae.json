{"nodes": [{"id": "backend_readme", "label": "Plataforma Negocio MVP README", "file_type": "document", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_readme_cierre_de_caja", "label": "Cierre de caja diario", "file_type": "concept", "source_file": "backend/README.md", "source_location": "L102,L121-L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One closing per day with withdrawals (retiros) and physical cash count (cuadre); owner marks each as revisado. Cannot be reopened once closed."}, {"id": "backend_readme_reporte_correo_smtp", "label": "Reporte de cierre por correo (Gmail SMTP)", "file_type": "concept", "source_file": "backend/README.md", "source_location": "L125-L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Python stdlib SMTP to avoid new dependencies; if SMTP_USER/SMTP_PASSWORD are empty the closing still works and only a log warning is emitted (graceful degradation)."}, {"id": "backend_readme_roles_permisos", "label": "Roles: dueno, contador, vendedor", "file_type": "concept", "source_file": "backend/README.md", "source_location": "L109-L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Role matrix: vendedor sees only own sales and no KPIs; only dueno creates/deactivates users and marks closings as revisado."}, {"id": "backend_readme_primer_dueno_bootstrap", "label": "Bootstrap del primer dueno (crear_dueno_inicial.py)", "file_type": "concept", "source_file": "backend/README.md", "source_location": "L47-L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users can only be created via API by a logged-in dueno, so the first owner must be created by a standalone script."}, {"id": "backend_readme_datos_demo", "label": "Datos de prueba DEMO (sembrar_datos_prueba.py)", "file_type": "concept", "source_file": "backend/README.md", "source_location": "L67-L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeded products are prefixed 'DEMO - ' so --limpiar deletes only demo data and never real catalog/sales."}, {"id": "backend_readme_power_bi_conexion", "label": "Conexion directa Power BI a PostgreSQL", "file_type": "concept", "source_file": "backend/README.md", "source_location": "L139-L144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Power BI reads normalized tables directly with a read-only user; no special API endpoint needed. App KPIs are only a summary."}, {"id": "backend_readme_pruebas_sqlite", "label": "Pruebas automaticas con SQLite temporal", "file_type": "concept", "source_file": "backend/README.md", "source_location": "L79-L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests use a temporary SQLite DB so the real PostgreSQL is never touched."}, {"id": "backend_readme_postgresql_opciones", "label": "PostgreSQL local (5432) o Docker (5433)", "file_type": "concept", "source_file": "backend/README.md", "source_location": "L10-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docker container uses port 5433 to avoid colliding with an existing Windows PostgreSQL service on 5432."}], "edges": [{"source": "backend_readme", "target": "backend_readme_cierre_de_caja", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_readme", "target": "backend_readme_reporte_correo_smtp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_readme", "target": "backend_readme_roles_permisos", "relation": "r